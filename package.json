{
  "name": "ephemeral-agent-wallet",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "demo": "node scripts/demo.mjs",
    "x402:local": "node scripts/x402-local.mjs",
    "agent": "npm --workspace @eaw/agent run start",
    "web": "npm --workspace @eaw/web run dev",
    "permission-agent": "npm --workspace @eaw/agent run permission --",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^22.20.4"
  }
}
