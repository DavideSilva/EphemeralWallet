# Optional: lets the agent plan with Claude. Without it the agent uses its offline planner.
ANTHROPIC_API_KEY=
# Set to "offline" to skip Claude even when a key is present.
AGENT_PLANNER=
# Defaults to the local Anvil chain started by npm run demo.
RPC_URL=http://127.0.0.1:8545

# x402 + Intercepta (Base Sepolia)
# For the Base Sepolia x402 flow set RPC_URL=https://sepolia.base.org above
# (npm run x402:local sets its own RPC_URL; x402 code defaults to Base Sepolia when unset).
INTERCEPTA_API_KEY=            # free key: https://intercepta.io/ethglobal
OWNER_PRIVATE_KEY=             # funds wallets (needs Base Sepolia ETH + USDC)
AGENT_PRIVATE_KEY=             # calls approvePayment (needs Base Sepolia ETH)
FACILITATOR_PRIVATE_KEY=       # settles payments (needs Base Sepolia ETH)
FACTORY_ADDRESS=               # from DeployX402
CLEAN_PAYTO=                   # an address you control with no mainnet risk history
RISKY_PAYTO=                   # risky test address from the Intercepta Discord pin
RISKY_OWNER=                   # risky test address used as a wallet owner
WALLET_ADDRESS=                # printed by x402:setup
PERMISSION_ID=0
RISKY_WALLET_ADDRESS=          # printed by x402:setup
# RISKY_PERMISSION_ID=0

# agent daemon / service ports and origins (defaults shown; uncomment to override)
# AGENT_PORT=4100
# SERVICE_PORT=4021
# SERVICE_URL=http://localhost:4021
# AGENT_UI_ORIGIN=http://localhost:5173
# SERVICE_UI_ORIGIN=http://localhost:5173  # CORS origin for the service; defaults to AGENT_UI_ORIGIN

# fork test (optional; `forge test` skips X402ForkTest when unset)
# BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# web UI endpoints (defaults shown; origins must match AGENT_UI_ORIGIN / SERVICE_URL exactly)
# VITE_AGENT_URL=http://localhost:4100
# VITE_SERVICE_URL=http://localhost:4021

# Mock x402 weather service (npm run weather). Address that receives the USDC payments.
WEATHER_PAY_TO=
